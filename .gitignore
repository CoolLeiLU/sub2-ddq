# Console build output and dependencies.  The Ant Design console is compiled
# from web/ by the Dockerfile and by CI, so neither the emitted bundle nor the
# installed packages are committed.
/web/node_modules/
/web/dist/
/web/*.tsbuildinfo
/src/sub2api_mcp/guardian/static/assets/
/src/sub2api_mcp/guardian/static/index.html

# Python packaging and generated builds
build/
dist/
site/
.eggs/
*.egg-info/
wheels/

