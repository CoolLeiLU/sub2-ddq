# Repository-local material
/docs/
/tests/
/tasks/

# Environment files and credentials
.env
.env.*
!.env.example
.envrc
*.key
*.pem
*.p12
*.pfx
/secrets/

# Python environments and bytecode
.venv/
venv/
env/
