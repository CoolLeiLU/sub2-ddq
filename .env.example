# === 1. 基础服务与凭证 ===
SUB2API_MCP_HOST=127.0.0.1
SUB2API_MCP_PORT=5310
SUB2API_MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*","sub2api-scheduler-mcp:*"]
SUB2API_MCP_DATABASE_PATH=./data/sub2api-mcp.db
SUB2API_MCP_SUB2API_ADMIN_KEY=replace-me
SUB2API_MCP_ACCESS_TOKENS=[{"name":"admin","token":"replace-with-at-least-32-random-characters","scopes":["sub2api:read","sub2api:write","sub2api:admin"]}]

# === 2. 调度器与慢首字守护 ===
SUB2API_MCP_SCHEDULER_ENABLED=false
SUB2API_MCP_PROBE_INTERVAL_SECONDS=60
SUB2API_MCP_SCHEDULER_LEASE_SECONDS=120
SUB2API_MCP_LOG_ACCOUNT_GUARD_ENABLED=true
SUB2API_MCP_SLOW_FIRST_TOKEN_MS=30000
SUB2API_MCP_LOG_LEVEL=INFO

# === 3. 视频任务（可选） ===
SUB2API_MCP_VIDEO_ENABLED=false
SUB2API_MCP_VIDEO_API_URL=https://h3.fzypod.com:9090/v1/video/generations
